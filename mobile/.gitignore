# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native projects generated by prebuild
android/
ios/

# Local Expo native modules (modules/<name>/) keep their `android/` sources,
# because they are hand-written, not generated by prebuild. Only the Gradle
# output is ignored.
!modules/*/android/
modules/*/android/.gradle/
modules/*/android/build/

# Local env files (never commit credentials)
.env
.env*
!.env.example

# Native build artifacts
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# typescript
*.tsbuildinfo
.expo/
android/app/.cxx/
android/app/build/
android/build/
android/.gradle/
android/local.properties
modules/*/android/build/
